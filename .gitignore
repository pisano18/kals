# Live collector output -- never commit, never modify (see RUNBOOK hard rule 5)
kalshi_data/
feed_data/
fulltape/
logs/

# Credentials -- the RSA key must never leave the box
*.pem
*.key

__pycache__/
*.pyc

# generated by research/go.py -- regenerated on each run
RESULTS.md
chain_cache.json

# run artefacts -- regenerated by research/everything.py every time
REPORT.md
RESULTS.md
kals-report-*.zip
schema.json
chain_cache.json
series_fin.json
series_crypto.json
comp.json
lead.json

# generated by research/flow.py -- per-day order-book aggregates, rebuildable
flow_cache/

# generated by research/pinentry.py -- one row per model-certain market,
# rebuildable from the tape in ~100 minutes
results/pinentry_rows.jsonl

# generated by research/pinexit.py -- one row per tracked market with its
# bid trace, rebuildable from the tape in ~5 hours (216 book hours)
results/pinexit_positions.jsonl

# rebuilt every two minutes by research/pindash.py --watch; committing it
# would churn ~840 KB per run and it is regenerable in seconds
results/dashboard.html

# 65 MB of walked tape rows -- rebuildable from the tape, never committed
results/pinpickoff_cache.json
results/pingrid_cache.json

# R4 (2026-09-23) -- the 1 Hz trajectory sampler writes its own file,
# tens of MB a day, rebuildable by nothing and needed by no reader in git.
results/pintraj-*.jsonl

# money-idea sweep scratch (research/sweep/): catalogue and per-agent work files, rebuildable
.sweep/
