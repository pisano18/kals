# Live collector output -- never commit, never modify (see RUNBOOK hard rule 5)
kalshi_data/
feed_data/
fulltape/
logs/

# Credentials -- the RSA key must never leave the box
*.pem
*.key

__pycache__/
*.pyc

# generated by research/go.py -- regenerated on each run
/RESULTS.md
chain_cache.json

# run artefacts -- regenerated by research/everything.py every time
/REPORT.md
kals-report-*.zip
schema.json
series_fin.json
series_crypto.json
comp.json
lead.json

# generated by research/flow.py -- per-day order-book aggregates, rebuildable
flow_cache/

# generated by research/pinentry.py -- one row per model-certain market,
# rebuildable from the tape in ~100 minutes
results/pinentry_rows.jsonl

# generated by research/pinexit.py -- one row per tracked market with its
# bid trace, rebuildable from the tape in ~5 hours (216 book hours)
results/pinexit_positions.jsonl

# rebuilt every two minutes by research/pindash.py --watch; committing it
# would churn ~840 KB per run and it is regenerable in seconds
results/dashboard.html

# 65 MB of walked tape rows -- rebuildable from the tape, never committed
results/pinpickoff_cache.json
results/pingrid_cache.json

# R4 (2026-09-23) -- the 1 Hz trajectory sampler writes its own file,
# tens of MB a day, rebuildable by nothing and needed by no reader in git.
results/pintraj-*.jsonl

# money-idea sweep scratch (research/sweep/): catalogue and per-agent work files, rebuildable
.sweep/

# ---- results/ process state (2026-09-25). Rewritten every few seconds by the
# live bot and its helpers. A pull --rebase --autostash that touches a tracked copy
# reverts a LIVE bot's state; the VM plan copies these by hand, never via git.
/results/*.pid
/results/*.heartbeat
/results/*.stop
/results/.run.lock
/results/.swept_seen
/results/pinrun-hwm.json
/results/pinrun-dayloss.json
/results/pinrun-live-size.json
/results/lab_control.json
/results/kalshi_ledger.json
/results/kalshi_transfers.json
/results/botstats_cache.json

# ---- results/ process stdout and continuously appended ops logs. Local diagnostics;
# no reader uses the git copy. run-*.log (run_when_away) stays tracked.
/results/*.out
/results/*.err
/results/*.err2
/results/*.console.log
/results/boot_all.log
/results/pindesk.log
/results/pinphone.log
/results/watch_bot.log
/results/restart_bot.last.log
/results/watch_hourly.log
/results/pinracearm*-live.log

# ---- results/ paper-arm and watcher logs. Local experiment data, growing daily
# (wxwatch ~7 MB/day would cross GitHub's 100 MB limit). Conclusions go to
# ARM_*.md / bars.py / HANDOFF. LIVE money logs are NOT here and stay tracked:
# pinrun-live-*.jsonl, pinracepenny-live.jsonl.
/results/pinrun-paper-*.jsonl
/results/pinracearm-*.jsonl
/results/cmdarm-*.jsonl
/results/wxwatch-*.jsonl
/results/quakewatch-*.jsonl
/results/rungwatch-*.jsonl

# ---- results/ LIVE and side-bot logs (2026-10-15). Claude Code's "Teleport auto-stash"
# (continuing a session on another machine) runs `git add -A; git stash`: on 2026-10-15
# 04:39:42Z it took 95 untracked files out of results/ -- every main-bot live log since
# 09-27, the ladder/forecaster/coin-race/paper logs -- while the bots were starting
# (stash@{0}; same thing 2026-09-26). Ignored files are not taken. The "LIVE money logs
# stay tracked" line above had lapsed in practice: no pinrun-live log after 09-25 was
# ever committed. Already-tracked copies (pinracepenny-live.jsonl, ...) stay tracked
# and can still be reverted by such a stash.
/results/pinrun-live-*.jsonl
/results/ladder-live*.jsonl
/results/forecaster-live*.jsonl
/results/bettor-live*.jsonl
/results/dipsell-*.jsonl
/results/racereward-*
/results/fcvar-paper*.jsonl
/results/cleanroom-*.jsonl
/results/rain-paper*.jsonl
/results/lipwatch*.jsonl
/results/portwatch-rec-*
/results/polypaper-*.jsonl
/results/*-stdout.log
/results/*-stderr.log
/results/pinracepenny-daystate.json

# ---- results/ rebuildable row caches (tens of MB each, regenerated per run)
/results/pinlook_*.json
/results/*_rows.jsonl
/results/*_rows.json
/results/**/*.pkl
/results/pindata*/

# tax ledger: rebuilt by research/taxledger.py, never committed (2026-09-26)
results/tax/

# ---- results/ strategy-hunt paper tests (2026-10-17): recorder data, locks, logs
/results/fxbook/
/results/fxbook-rec.jsonl
/results/fxbook-rec.lock
/results/fxreward-paper.lock
/results/fxreward-v5.lock
