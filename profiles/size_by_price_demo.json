{
  "name": "size_by_price_demo",
  "note": "DEMO for the builder: 40 contracts under 90c, 20 at 90-99c. Not a recommendation.",
  "params": {
    "PIN": 0.995,
    "PRICE_CEILING": 0.98,
    "TAU_MIN": 3,
    "TAU_MAX": 30,
    "EDGE_FLOOR": 0.003,
    "EV_FLOOR": 0.003,
    "MEASURED_FLIP": 0.009,
    "SIZE": {
      "by": "price",
      "default": 20,
      "bands": [
        [
          0.5,
          0.9,
          40
        ],
        [
          0.9,
          0.99,
          20
        ]
      ]
    },
    "MAX_PER_CLOSE": 2,
    "MIN_FILL_FRAC": 0.5,
    "IMPROVE_BY": 0.005,
    "MAX_BOOK_AGE_MS": 2000,
    "MAX_INDEX_AGE_S": 2.0,
    "SIGMA_STRESS": 1.0,
    "LOSS_ABORT": -60.0,
    "MAX_LOSSES": 3
  },
  "rules": [
    {
      "id": "dump",
      "name": "Crazy deal",
      "enabled": true,
      "action": "refuse",
      "when": {
        "all": [
          [
            "conf",
            ">=",
            0.999
          ],
          [
            "discount_c",
            ">",
            5
          ]
        ]
      },
      "note": "The model calls it certain and someone is still selling it 5c+ below fair. Both live losses at extreme confidence had this shape. EV undeterminable on six fills; owner chose fewer losses. Review at 40 records."
    }
  ]
}
