+# hype live but scaled down proportionally to where the max bet is a loss
+# that doesn't matter. Live tests are better." --coin-size-frac SERIES:F
+# (repeatable): that 15-minute series bets max(1, floor(SIZE x F)) instead
+# of SIZE -- the early leg (EARLY_FRAC x it), the top-up (to it), the
+# full-bet room and the cap after every widener all read that number, so
+# the market never holds more than MAX_FULL_BETS x floor(SIZE x F) x the
+# late multiple. SIZE is read at call time, so it follows every autosize
+# (proportional, as asked). A GATE MUST NEVER BLOCK A HEDGE: nothing here
+# touches the hedge pass; a held position is hedged in full whatever its
+# size. Never a ladder series (those are series_size_for's).
+# Default {} = OFF = today's behaviour exactly.
+COIN_SIZE_FRAC = {}
+_DEFAULT_COIN_SIZE_FRAC = {}
+
+
+def coin_size_for(ticker, frac=None, base=None):
+    """v-coinfrac: the FULL BET for a --coin-size-frac 15-minute series --
+    max(1, floor(SIZE x F)) -- or None for every other ticker (the ordinary
+    SIZE path). `frac` overrides COIN_SIZE_FRAC and `base` overrides SIZE,
+    for tests. FAILS SMALL: a fraction set but unreadable gives 1 contract,
+    never None -- None would hand the coin the whole bank-driven SIZE."""
+    coins = COIN_SIZE_FRAC if frac is None else frac
+    if not coins:
+        return None
+    try:
+        head = str(ticker).split("-", 1)[0]
+    except Exception:                                    # noqa: BLE001
+        return None
+    if head not in coins or head in LADDER_SERIES:
+        return None
+    v = series_frac_size(coins.get(head), SIZE if base is None else base)
+    return 1.0 if v is None else float(v)
+
