+# "Okay one full coin max. Or does a 1.5 coin do better? Check it out."
+# --max-full-bets X: an ENTRY order may not take the contracts this market
+# already holds on THAT side past X x the full bet in force (SIZE -- or the
+# ladder's series size -- times the same band / doubt / late multiple v-topup
+# completes a position to). A partial order is TRIMMED to the room, not
+# refused: a top-up of an unfinished position still completes it. A market
+# with no room left is refused before the signal (gate `full_cap`, no attempt
+# burned). The backport of v-onefull (09-27) + v-topup (09-30) to the 09-25
+# build, as one count rule. Default 0 = OFF = the 09-25 behaviour exactly.
+# A GATE MUST NEVER BLOCK A HEDGE: this is consulted on the entry path only
+# (the hedge pass never calls it), and even there it stands down for a market
+# already insured (hedged_side set: A68's own cap governs the re-buy) and for
+# an entry on the OTHER side from the one held (a re-buy into a hedge).
+MAX_FULL_BETS = 0.0
+_DEFAULT_MAX_FULL_BETS = 0.0
+
+
+def full_bet_room(prev, tk, want, mult=1.0, hedged=None, size=None, x=None):
+    """v-fullcap: contracts an ENTRY on `want` in market `tk` may still add.
+
+    None = the cap does not apply (flag off, an insured market, or the other
+    side from the one held). Otherwise X x full - held, floored at 0, where
+    full = (size or SIZE) x max(1, mult) and held = contracts this close has
+    booked in `tk` (prev["n_tk"]) when the side held is `want`.
+    Reads MAX_FULL_BETS and SIZE at call time, so the flag takes effect."""
+    x = MAX_FULL_BETS if x is None else float(x)
+    if not x or x <= 0:
+        return None
+    if hedged is not None:
+        return None                      # insured: the hedge path owns it
+    held_side = ((prev or {}).get("sides") or {}).get(tk)
+    if held_side is not None and held_side != want:
+        return None                      # the other side: never capped here
+    have = 0.0
+    if held_side == want:
+        try:
+            have = float(((prev or {}).get("n_tk") or {}).get(tk, 0.0))
+        except (TypeError, ValueError):
+            have = 0.0
+    full = float(SIZE if size is None else size) * max(1.0, float(mult or 1.0))
+    return max(0.0, float(x) * full - have)
